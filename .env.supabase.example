# ==============================================================================
# CAMPUS PLUS — SUPABASE ENVIRONMENT CONFIGURATION TEMPLATE (.env.supabase.example)
# Target Project: CampusPlus (gtwpxjpmwltxwjryazcu) / Region: ap-northeast-1 (Tokyo)
# ==============================================================================
# Copy the values below into your local .env.local file:
# cp .env.supabase.example .env.local
#
# Where to find these values in the Supabase Dashboard:
# 1. Project URL & Anon Key: Project Settings -> API
# 2. Service Role Key: Project Settings -> API (Service Role Secret)
# 3. Database URL: Project Settings -> Database -> Connection string -> URI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT BROWSER CONFIGURATION (NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Supabase Project HTTPS API Gateway URL
NEXT_PUBLIC_SUPABASE_URL="https://gtwpxjpmwltxwjryazcu.supabase.co"

# Supabase Publishable Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here"

# Canonical Web Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE CREDENTIALS (CONFIDENTIAL — NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for administrative / background tasks)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here"

# Supabase JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONNECTIONS
# ------------------------------------------------------------------------------
# A. For Local Development / Long-Running Node servers (Direct Session Mode, Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gtwpxjpmwltxwjryazcu.supabase.co:5432/postgres"
#
# B. For Vercel Serverless / Cloud Hosting (Supavisor Transaction Pooler, Port 6543):
DATABASE_URL="postgresql://postgres.gtwpxjpmwltxwjryazcu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 4. STORAGE BUCKET CONFIGURATION
# ------------------------------------------------------------------------------
STORAGE_BUCKET_ATTACHMENTS="campus-plus-attachments"
STORAGE_MAX_FILE_SIZE_BYTES="5242880" # 5 MB (5,242,880 bytes)

# ------------------------------------------------------------------------------
# 5. APPLICATION SECRETS
# ------------------------------------------------------------------------------
APP_SECRET="dev_app_secret_at_least_32_characters_long_for_security"
CRON_SECRET="dev_cron_secret_min_8_chars"
LOG_LEVEL="info"
