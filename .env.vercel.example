# ==============================================================================
# CAMPUS PLUS — VERCEL ENVIRONMENT CONFIGURATION TEMPLATE (.env.vercel.example)
# ==============================================================================
# Use this template when configuring Environment Variables in the Vercel Dashboard:
# Project Settings -> Environment Variables
# Or when importing via Vercel CLI: `vercel env pull` / `vercel env add`
#
# ENVIRONMENTS IN VERCEL:
# - Production: Attached to your 'main' / 'master' production domain.
# - Preview: Automatically provisioned for pull requests and staging branches.
# - Development: Used with `vercel dev` locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed in Browser Bundle)
# ------------------------------------------------------------------------------

# Production / Canonical application URL (e.g., https://campus-plus.vercel.app)
# For Preview environments in Vercel, you can also use https://$VERCEL_URL
NEXT_PUBLIC_APP_URL="https://campus-plus.vercel.app"

# Environment descriptor: "production" | "staging" | "development"
NEXT_PUBLIC_APP_ENV="production"

# Supabase Project HTTPS API Gateway URL
# Target: https://gtwpxjpmwltxwjryazcu.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://gtwpxjpmwltxwjryazcu.supabase.co"

# Supabase Publishable Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_anon_key_here"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (STRICTLY CONFIDENTIAL — NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------

# Application Node runtime environment
NODE_ENV="production"

# Structured Logger Level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# Core application encryption / signing secret (Minimum 32 random characters)
# Generate with: openssl rand -base64 32
APP_SECRET="replace_with_cryptographically_secure_random_string_min_32_chars"

# Authorization secret for triggering automated SLA monitor cron tasks
# Pass as: Bearer <CRON_SECRET> in header for scheduled endpoints
CRON_SECRET="replace_with_secure_random_cron_trigger_secret"

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (SUPABASE POSTGRESQL POOLER FOR SERVERLESS)
# ------------------------------------------------------------------------------
# CRITICAL VERCEL SERVERLESS GUIDANCE:
# On Vercel, Serverless Functions scale horizontally and can quickly exhaust
# standard PostgreSQL connection limits (port 5432).
# ALWAYS use Supabase Supavisor Connection Pooler:
# - Transaction Mode (Port 6543): RECOMMENDED for Vercel Serverless Functions.
# - Session Mode (Port 5432): For migrations and persistent long-lived connections.
#
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.gtwpxjpmwltxwjryazcu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Supabase Service Role Key (Server-Only, bypasses RLS for administrative operations)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_service_role_key_here"

# Supabase JWT Secret (Server-Only, for decoding / verifying user JWTs)
SUPABASE_JWT_SECRET="your_production_supabase_jwt_secret_here"

# ------------------------------------------------------------------------------
# 4. STORAGE / S3 BUCKET CONFIGURATION
# ------------------------------------------------------------------------------
# Dedicated private Supabase Storage bucket for grievance attachments and resolution proof
STORAGE_BUCKET_ATTACHMENTS="campus-plus-attachments"

# Maximum allowed file upload size in bytes (5 MB = 5,242,880 bytes per BR-05)
STORAGE_MAX_FILE_SIZE_BYTES="5242880"
